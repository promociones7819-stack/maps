{
  "name": "bizkaia-aerial-routes",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-legal.mjs && vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/electron-dev.cjs",
    "icon:mac": "node scripts/make-icon.cjs",
    "package:mac": "npm run icon:mac && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "ios:sync": "npm run build && cap sync ios",
    "test:racebox": "node tests/racebox.mjs && node tests/lessons-ui.mjs",
    "test:studio": "node tests/review-time.mjs && node tests/studio-ui.mjs",
    "prepare": "npm run build",
    "test:movie": "node tests/final-movie.mjs",
    "test:workspace": "node tests/movie-writer.mjs && node tests/workspace-ui.mjs",
    "test:desktop-workspace": "node tests/desktop-workspace.mjs",
    "test:bluetooth": "node tests/racebox.mjs && node tests/ble-connection.mjs && node tests/desktop-bluetooth.mjs",
    "test:map-recording": "node tests/map-recording.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:board": "node tests/board-model.mjs && node tests/board-expanded.mjs && node tests/didactic-board.mjs && node tests/didactic-board-mobile.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "mapbox-gl": "^3.32.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.traza.bizkaia",
    "productName": "RutasAD",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "RutasAD usa el micrófono si eliges grabar voz para las clases.",
        "NSBluetoothAlwaysUsageDescription": "RutasAD necesita Bluetooth para conectar con tu RaceBox Mini o Mini S y recibir los datos de la práctica."
      }
    },
    "dmg": {
      "title": "RutasAD",
      "artifactName": "RutasAD.dmg",
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 420,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "copyright": "Copyright © 2026 Aitor Delgado Martínez · AD Mobility",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "RutasAD-${version}-Windows-x64-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Aitor Delgado Martínez (AD Mobility)",
  "description": "RutasAD: recorridos, vídeo y pizarra didáctica para formación vial"
}
