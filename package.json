{
  "name": "bizkaia-aerial-routes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/electron-dev.cjs",
    "icon:mac": "node scripts/make-icon.cjs",
    "package:mac": "npm run icon:mac && npm run build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "mapbox-gl": "^3.32.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.traza.bizkaia",
    "productName": "Traza Bizkaia",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Traza Bizkaia usa el micrófono si eliges grabar voz para las clases."
      }
    },
    "dmg": {
      "title": "Traza Bizkaia",
      "artifactName": "Traza-Bizkaia-${version}-${arch}.dmg",
      "contents": [
        { "x": 140, "y": 170, "type": "file" },
        { "x": 420, "y": 170, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
