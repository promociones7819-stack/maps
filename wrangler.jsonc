{
  "name": "maps",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  },
  "main": "server/worker.js",
  "d1_databases": [
    {
      "binding": "AUTH",
      "database_name": "rutasad-auth",
      "database_id": "b4769b34-1321-4f6f-bfc4-74af49ff2713"
    }
  ]
}
